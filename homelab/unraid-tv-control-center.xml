<?xml version="1.0"?>
<Container version="2">
  <Name>tv-control-center</Name>
  <Repository>ashishdungdung/tv-control-center:latest</Repository>
  <Registry>https://hub.docker.com/repository/docker/ashishdungdung/tv-control-center/general</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/ashishdungdung/tv-control-center/issues</Support>
  <Project>https://github.com/ashishdungdung/tv-control-center</Project>
  <Overview>Universal Smart TV Management Suite for Sony BRAVIA, NVIDIA SHIELD, TCL, Hisense, Fire TV, Chromecast, Xiaomi</Overview>
  <Category>Tools: MediaApp:Video Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:8888]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/ashishdungdung/tv-control-center/main/homelab/unraid-tv-control-center.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/ashishdungdung/tv-control-center/main/bravia_control/static/favicon.ico</Icon>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>8888</HostPort>
        <ContainerPort>8888</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Environment>
    <Variable>
      <Value>192.168.2.122:5555</Value>
      <Name>ADB_TARGET</Name>
      <Mode/>
    </Variable>
  </Environment>
</Container>
